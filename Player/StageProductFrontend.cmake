file(REAL_PATH "${BINARY_ROOT}" binaryRoot)
file(REAL_PATH "${PRODUCT_DIRECTORY}" productDirectory)
cmake_path(IS_PREFIX binaryRoot "${productDirectory}" NORMALIZE insideBuild)
if(NOT insideBuild OR NOT EXISTS "${FRONTEND_DIST}/index.html")
    message(FATAL_ERROR "Cannot stage the product frontend outside its build tree or from a missing build")
endif()
file(MAKE_DIRECTORY "${productDirectory}")

set(package "${productDirectory}/launcher")
if(EXISTS "${package}" OR IS_SYMLINK "${package}")
    file(REAL_PATH "${package}" resolvedPackage)
    if(IS_SYMLINK "${package}" OR NOT resolvedPackage STREQUAL package)
        message(FATAL_ERROR "Unexpected product frontend destination: ${package}")
    endif()
    file(REMOVE_RECURSE "${package}")
endif()
file(COPY "${FRONTEND_DIST}/" DESTINATION "${package}")
