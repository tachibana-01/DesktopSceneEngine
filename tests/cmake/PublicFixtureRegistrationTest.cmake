set(WIN32 FALSE)
set(BUILD_PLAYER FALSE)
# The application library is irrelevant to media registrations. Mark it as
# supplied so the capture can read the actual tests' CMakeLists without Qt.
add_library(DSE::Application INTERFACE IMPORTED)
get_filename_component(CMAKE_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(CMAKE_CURRENT_SOURCE_DIR "${CMAKE_SOURCE_DIR}/tests")
if(DSE_FIXTURE_CASE STREQUAL "opted-in")
    set(fixture_root "${DSE_FIXTURE_CAPTURE_ROOT}/media")
elseif(DSE_FIXTURE_CASE STREQUAL "missing")
    set(fixture_root "${DSE_FIXTURE_CAPTURE_ROOT}/missing")
elseif(DSE_FIXTURE_CASE STREQUAL "incomplete")
    set(fixture_root "${DSE_FIXTURE_CAPTURE_ROOT}/incomplete")
else()
    set(fixture_root "")
endif()
set(DESKTOP_SCENE_ENGINE_EXTERNAL_FIXTURES_DIR "${fixture_root}" CACHE PATH "")
include("${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt")

get_property(targets GLOBAL PROPERTY fixture_capture_targets)
foreach(basename ActiveProjectionRebuildTest EngineSceneNavigationTest EngineSeekTest VideoResourceTest
        PreviewVideoDecoderTest TimelinePreviewProviderTest TimelinePreviewWorkerTest RepresentativeFrameStoreIntegrationTest)
    set(target "DesktopSceneEngine_${basename}")
    get_property(invocation GLOBAL PROPERTY "fixture_command_${target}_ExternalMedia")
    if(DSE_FIXTURE_CASE STREQUAL "opted-in")
        if(NOT target IN_LIST targets)
            message(FATAL_ERROR "Missing external-media target ${target}")
        endif()
        if(basename STREQUAL "VideoResourceTest")
            set(expected "${target};${fixture_root}/Videos/a.synthetic.mp4")
        else()
            set(expected "${target}")
            get_property(definitions GLOBAL PROPERTY "fixture_definitions_${target}")
            if(NOT "DESKTOP_SCENE_ENGINE_TEST_RESOURCES_DIR=\"${fixture_root}\"" IN_LIST definitions)
                message(FATAL_ERROR "External fixture root did not reach ${target}")
            endif()
        endif()
        if(NOT invocation STREQUAL expected)
            message(FATAL_ERROR "Incorrect external-media invocation for ${target}")
        endif()
    elseif(invocation)
        message(FATAL_ERROR "External-media test ${target} registered without an explicit fixture root")
    endif()
endforeach()

foreach(pair IN ITEMS "ActiveProjectionRebuildTest_FixtureIndependent:ActiveProjectionRebuildTest;--fixture-independent"
        "EngineSceneNavigationTest_FixtureIndependent:EngineSceneNavigationTest;--fixture-independent"
        "EngineSeekTest_Generated:EngineSeekTest;--generated"
        "TimelinePreviewProviderTest_Generated:TimelinePreviewProviderTest;--generated"
        "TimelinePreviewWorkerTest_Generated:TimelinePreviewWorkerTest;--generated"
        "VideoResourceTest_MissingPath:VideoResourceTest" "RepresentativeFrameStoreTest:RepresentativeFrameStoreTest")
    string(REPLACE ":" ";" parts "${pair}")
    list(POP_FRONT parts case)
    get_property(invocation GLOBAL PROPERTY "fixture_command_DesktopSceneEngine_${case}")
    if(NOT invocation STREQUAL "DesktopSceneEngine_${parts}")
        message(FATAL_ERROR "Incorrect clean-clone invocation for ${case}")
    endif()
endforeach()

get_property(audio GLOBAL PROPERTY fixture_command_DesktopSceneEngine_AudioResourceTest)
set(synthetic "${CMAKE_SOURCE_DIR}/tests/TestData/Audio/SequentialAudioSourceCompressed.mp3")
if(NOT audio STREQUAL "DesktopSceneEngine_AudioResourceTest;${synthetic}" OR NOT EXISTS "${synthetic}")
    message(FATAL_ERROR "AudioResourceTest must run with the tracked synthetic MP3")
endif()
get_property(store_definitions GLOBAL PROPERTY fixture_definitions_DesktopSceneEngine_RepresentativeFrameStoreTest)
if(store_definitions MATCHES "DESKTOP_SCENE_ENGINE_TEST_RESOURCES_DIR")
    message(FATAL_ERROR "Generated frame store acquired an external fixture dependency")
endif()
