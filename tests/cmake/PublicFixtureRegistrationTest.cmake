    set_property(GLOBAL APPEND PROPERTY fixture_capture_targets "${target}")
endfunction()
function(add_test)
    cmake_parse_arguments(PARSE_ARGV 0 test "" "NAME" "COMMAND")
    set_property(GLOBAL PROPERTY "fixture_command_${test_NAME}" "${test_COMMAND}")
