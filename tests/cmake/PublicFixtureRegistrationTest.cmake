cmake_minimum_required(VERSION 3.25)

# Capture the actual fixture registrations without building or decoding media.
if(NOT DEFINED DSE_FIXTURE_CASE)
    string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" nonce)
    set(fixture "${CMAKE_CURRENT_BINARY_DIR}/registration-fixtures-${nonce}")
    if(EXISTS "${fixture}")
        message(FATAL_ERROR "Fixture registration test needs a fresh directory")
    endif()
    file(MAKE_DIRECTORY "${fixture}/media/Images" "${fixture}/media/Videos" "${fixture}/incomplete")
    foreach(marker Images/a.synthetic.png Images/second.jpg Videos/a.synthetic.mp4 Videos/second.mp4)
        file(WRITE "${fixture}/media/${marker}" "Registration marker; no encoded media\n")
    endforeach()
    file(WRITE "${fixture}/CMakeLists.txt"
        "cmake_minimum_required(VERSION 3.25)\n"
        "project(FixtureRegistrationCapture LANGUAGES NONE)\n"
        "include([==[${CMAKE_CURRENT_LIST_FILE}]==])\n")

    set(failures "")
    foreach(case default opted-in missing incomplete)
        execute_process(COMMAND "${CMAKE_COMMAND}"
            -S "${fixture}" -B "${fixture}/build-${case}"
            "-DDSE_FIXTURE_CASE=${case}" "-DDSE_FIXTURE_CAPTURE_ROOT=${fixture}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(case STREQUAL "missing" OR case STREQUAL "incomplete")
            if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "External fixture configuration:")
                string(APPEND failures "${case}: expected explicit fixture rejection\n${output}${error}\n")
            endif()
        elseif(NOT result EQUAL 0)
            string(APPEND failures "${case}: ${output}${error}\n")
        elseif(case STREQUAL "default" AND NOT output MATCHES "External media tests: UNAVAILABLE")
            string(APPEND failures "Default configure did not explain unavailable media\n")
        endif()
    endforeach()

    file(REAL_PATH "${CMAKE_CURRENT_BINARY_DIR}" binary_path)
    file(REAL_PATH "${fixture}" fixture_path)
    cmake_path(IS_PREFIX binary_path "${fixture_path}" NORMALIZE owned)
    if(NOT owned OR fixture_path STREQUAL binary_path)
        message(FATAL_ERROR "Fixture registration test cleanup boundary mismatch")
    endif()
    file(REMOVE_RECURSE "${fixture_path}")
    if(failures)
        message(FATAL_ERROR "${failures}")
    endif()
    message(STATUS "Public fixture registration: default, opted-in, missing and incomplete PASS")
    return()
endif()

